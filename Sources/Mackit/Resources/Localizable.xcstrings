          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未授予"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용되지 않음"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未許可"
          }
        }
      }
    },
    "permissions.status.undetermined": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없음"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明"
          }
        }
      }
    },
    "permissions.status.onDemand": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用时请求"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On demand"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用時請求"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 시 요청"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用時に要求"
          }
        }
      }
    },
    "permissions.hint.notGranted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置，开启 Mackit 对应的开关即可"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings and turn Mackit on"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開系統設定，開啟 Mackit 對應的開關即可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정을 열고 Mackit 스위치를 켜세요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定を開き、Mackitのスイッチをオンにしてください"
          }
        }
      }
    },
    "permissions.hint.onDemand": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需提前授予：每次使用时，系统会弹窗询问"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to grant up front — the system asks each time it's used"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需提前授予：每次使用時，系統會彈出視窗詢問"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 허용할 필요가 없습니다. 사용할 때마다 시스템이 확인 창을 표시합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "事前に許可する必要はありません。使用するたびにシステムが確認を求めます。"
          }
        }
      }
    },
    "permissions.hint.undetermined.automation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标应用当前没有运行，暂时无法判断；等待应用运行后会自动重新检测"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target app isn't running, so this can't be determined yet — it re-checks once the app is running"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標 App 目前沒有執行，暫時無法判斷；等待 App 執行後會自動重新檢測"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 앱이 실행 중이 아니므로 아직 판단할 수 없습니다. 앱이 실행되면 자동으로 다시 확인합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象のAppが実行中でないため、まだ判断できません。Appが実行されると自動的に再確認します。"
          }
        }
      }
    },
    "permissions.hint.undetermined.fullDiskAccess": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法判断；应用回到前台时会自动重新检测。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't be determined right now — it re-checks when the app becomes active again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法判斷；App 回到前台時會自動重新偵測。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 판단할 수 없습니다. 앱이 다시 활성화되면 자동으로 재확인합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現時点では判断できません。Appが再度アクティブになると自動的に再確認します。"
          }
        }
      }
    },
    "settings.permissions.header": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限管理"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "權限管理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 관리"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス権の管理"
          }
        }
      }
    },
    "settings.permissions.intro": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设置中授予 Mackit 的权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The permissions granted to Mackit in System Settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統設定中授予 Mackit 的權限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 Mackit에 부여한 권한입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でMackitに許可されたアクセス権です。"
          }
        }
      }
    },
    "settings.permissions.footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit 未启用 App Sandbox，这些权限决定它能读取哪些位置。拒绝其中任何一项，对应的功能会自动降级，不会在使用过程中弹窗打扰。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit runs without the App Sandbox, so these permissions decide what it can read. Refusing any of them only degrades the matching feature — nothing interrupts you mid-scan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit 未啟用 App Sandbox，這些權限決定它能讀取哪些位置。拒絕其中任何一項，對應的功能會自動降級，不會在使用過程中彈出視窗打擾。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit은 App Sandbox 없이 실행되므로 이러한 권한이 읽을 수 있는 위치를 결정합니다. 권한을 거부하면 해당 기능만 제한될 뿐, 사용 중에 대화상자가 표시되지는 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MackitはApp Sandboxなしで実行されるため、これらのアクセス権が読み取れる場所を決定します。いずれかを拒否しても、該当する機能が制限されるだけで、使用中にダイアログが表示されることはありません。"
          }
        }
      }
    },
    "permissions.action.request": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求权限"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求權限"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 요청"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス権を要求"
          }
        }
      }
    },
    "permissions.action.request.help": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统会弹窗询问是否允许 Mackit 控制该应用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system asks whether Mackit may control this app"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統會彈出視窗詢問是否允許 Mackit 控制該 App"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 Mackit이 이 앱을 제어할 수 있는지 묻는 창을 표시합니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムがMackitにこのAppを操作する許可を与えるか確認するプロンプトを表示します"
          }
        }
      }
    },
    "permissions.hint.notRequested": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授权。点击“请求权限”，在系统弹窗中允许即可。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not requested yet — click Request and allow Mackit in the system prompt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授權。按一下「請求權限」，在系統彈出視窗中允許即可。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 요청하지 않았습니다. \"권한 요청\"을 클릭하고 시스템 창에서 Mackit을 허용하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ要求していません。「アクセス権を要求」をクリックし、システムのプロンプトでMackitを許可してください。"
          }
        }
      }
    }
  }
}
