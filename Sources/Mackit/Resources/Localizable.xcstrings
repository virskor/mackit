    "settings.menubar.temperature": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示温度"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show temperature"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示溫度"
          }
        }
      }
    },
    "settings.menubar.footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 与内存取自系统公开接口。macOS 没有公开的温度数值接口，温度行显示的是系统热状态。「释放内存」会请求管理员授权并执行 purge，清空磁盘文件缓存；应用自身占用的内存不会被释放。关闭图标后，若三项数值也全部关闭，菜单栏仍会保留图标，否则应用将从菜单栏消失。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU and memory come from public system APIs. macOS exposes no numeric temperature reading, so the temperature row shows the system thermal state. “Free Up Memory” asks for administrator authorization and runs purge, which flushes the disk file cache; memory held by apps is not released. With the icon off and every value off as well, the icon is kept anyway — otherwise the app would disappear from the menu bar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 與記憶體取自系統公開介面。macOS 沒有公開的溫度數值介面，溫度列顯示的是系統熱狀態。「釋放記憶體」會請求管理員授權並執行 purge，清空磁碟檔案快取；應用程式本身佔用的記憶體不會被釋放。關閉圖示後，若三項數值也全部關閉，選單列仍會保留圖示，否則應用程式將從選單列消失。"
          }
        }
      }
    },
    "settings.overlay.header": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面悬浮窗"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Overlay"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面懸浮窗"
          }
        }
      }
    },
    "settings.overlay.show": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在桌面显示悬浮统计窗"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show floating stats on the desktop"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在桌面顯示懸浮統計窗"
          }
        }
      }
    },
    "settings.overlay.footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬浮窗常驻桌面最上层，可拖动到任意位置（位置会被记住），点一下打开主窗口。显示哪几项跟随上方的「菜单栏显示」开关；三项全关时悬浮窗自动收起。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The overlay stays on top of the desktop. Drag it anywhere — the position is remembered — and click it to open the main window. What it shows follows the Menu Bar Display switches above; with all three off, the overlay hides itself."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "懸浮窗常駐桌面最上層，可拖曳到任意位置（位置會被記住），點一下開啟主視窗。顯示哪幾項跟隨上方的「選單列顯示」開關；三項全關時懸浮窗會自動收起。"
          }
        }
      }
    },
