    "rule.sim.coresimulator-caches.note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器动态库缓存，体积大且可完全重建"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator dynamic library caches; large but fully rebuildable"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬器動態函式庫快取，體積大且可完全重建"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이터 동적 라이브러리 캐시, 크기가 크며 완전히 다시 빌드 가능"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレータのダイナミックライブラリキャッシュ、サイズが大きく完全に再構築可能"
          }
        }
      }
    },
