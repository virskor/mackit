    "homebrew.notInstalled.explain": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 是 macOS 的软件包管理器。安装之后，就可以在这里查看已安装的软件包、更新状态，并清理它占用的磁盘空间。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew is the missing package manager for macOS. Once it is installed you can review your packages, see what is out of date, and reclaim the space it uses — all from this page."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 是 macOS 的套件管理器。安裝之後，就可以在這裡查看已安裝的套件、更新狀態，並清理它佔用的磁碟空間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew는 macOS의 패키지 관리자입니다. 설치한 후에는 이 페이지에서 설치된 패키지와 업데이트 상태를 확인하고, Homebrew가 사용하는 디스크 공간을 확보할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew は macOS のパッケージマネージャです。インストール後は、このページからインストール済みのパッケージや更新状況を確認し、Homebrew が使用するディスク容量を確保できます。"
          }
        }
      }
    },
