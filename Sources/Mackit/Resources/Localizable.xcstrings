    "diskAnalysis.truncated.explain": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹的内容尚未展开。扫描后即可查看其中的空间构成。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder's contents haven't been expanded yet. Scan it to see where its space went."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案夾的內容尚未展開。掃描後即可查看其中的空間構成。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더의 내용은 아직 펼쳐지지 않았습니다. 스캔하면 공간 구성을 확인할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダの内容はまだ展開されていません。スキャンすると、容量の内訳を確認できます。"
          }
        }
      }
    },
