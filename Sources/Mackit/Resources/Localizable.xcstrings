    "permissions.item.fullDiskAccess.what": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取 ~/Library 各处的开发者缓存、应用的最近打开时间，以及大文件扫描中受保护的文件夹"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads developer caches across ~/Library, apps' last-opened times, and the protected folders the large-file walk covers"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取 ~/Library 各處的開發者快取、App 的最近打開時間，以及大檔案掃描中受保護的資料夾"
          }
        }
      }
    },
