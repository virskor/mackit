    "largeFiles.tool.rescan.help": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新遍历整个启动磁盘"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk the whole startup disk again"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新遍历整個啟動磁碟"
          }
        },
        "ko": {
