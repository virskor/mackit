{
  "sourceLanguage": "zh-Hans",
  "version": "1.1",
  "strings": {
    "clean.confirm.languageMessage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受影响应用的界面会回退到英文或其他语言，重装或更新应用后才能恢复（共 %lld 个语言包）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The affected apps fall back to English or another language until they are reinstalled or updated (%lld language packs)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受影響 App 的介面會回退到英文或其他語言，重新安裝或更新 App 後才能恢復（共 %lld 個語言套件）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영향을 받는 앱의 인터페이스가 영어 또는 다른 언어로 돌아가며, 앱을 다시 설치하거나 업데이트해야 복원됩니다(언어 팩 %lld개)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影響を受けるAppのインターフェイスは英語または他の言語にフォールバックし、Appを再インストールまたは更新するまで復元されません（言語パック%lld個）。"
          }
        }
      }
    },
    "clean.confirm.languageTitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含无用语言包"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes Unused Language Files"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含無用語言套件"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미사용 언어 팩 포함"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未使用の言語パックを含む"
          }
        }
      }
    },
    "clean.result.movedToTrash": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次移出 %@（移入废纸篓的部分在清空后释放）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved %@ out (what went to the Trash is freed once it is emptied)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次移出 %@（移入垃圾桶的部分在清空後釋放）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번에 %@ 이동(휴지통으로 이동한 항목은 비운 후 확보)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回%@を移動しました（ゴミ箱に移動した項目は、ゴミ箱を空にすると確保されます）"
          }
        }
      }
    },
    "menu.checkForUpdates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查更新…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 확인…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを確認…"
          }
        }
      }
    },
    "rule.xcode.deriveddata.title": {
      "localizations": {
        "zh-Hans": {
