    "settings.about.privacy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit 不会删除你的源代码与项目配置，只清理各工具可再生的缓存与构建产物。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit never deletes your source code or project configuration; it only cleans caches and build artifacts that tools can regenerate."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit 不會刪除你的原始碼與專案配置，只會清理各種工具可再生的快取與建置產物。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit은 소스 코드와 프로젝트 설정을 삭제하지 않으며, 도구가 다시 생성할 수 있는 캐시와 빌드 산출물만 정리합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackitはソースコードやプロジェクトの設定を削除せず、ツールが再生成できるキャッシュとビルド成果物のみをクリーンアップします。"
          }
        }
      }
    },
