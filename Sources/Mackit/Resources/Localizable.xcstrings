    "largeFiles.empty.message": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前阈值下没有文件达到大小，可以降低阈值后重新扫描。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No files reach the current threshold. Lower it and walk again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前閾值下沒有檔案達到大小，可以降低閾值後重新掃描。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 임계값을 넘는 파일이 없습니다. 임계값을 낮추고 다시 스캔하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のしきい値を超えるファイルはありません。しきい値を下げて再スキャンしてください。"
          }
        }
      }
    },
