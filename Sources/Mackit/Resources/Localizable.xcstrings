    "clean.confirm.cautionTitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含谨慎清理项"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes Caution Items"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含謹慎清理項目"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주의가 필요한 항목 포함"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注意が必要な項目を含む"
          }
        }
      }
    },
    "clean.confirm.cautionMessage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中包含废纸篓、iOS 备份或历史归档，删除后无法自动恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes Trash contents, iOS backups, or historical archives that cannot be restored automatically after deletion."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中包含垃圾桶、iOS 備份或歷史歸檔，刪除後無法自動恢復。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통 내용물, iOS 백업 또는 과거 아카이브가 포함되어 있어 삭제 후 자동으로 복원할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱の内容、iOSバックアップ、または過去のアーカイブが含まれており、削除後に自動で復元することはできません。"
          }
        }
      }
    },
    "clean.confirm.reviewTitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含需留意项"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes Items to Review"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含需留意項目"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인이 필요한 항목 포함"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が必要な項目を含む"
          }
        }
      }
    },
    "clean.confirm.reviewMessage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中包含需重新下载或重新构建的缓存，清理后首次构建会变慢。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes caches that must be re-downloaded or rebuilt; the first build after cleaning will be slower."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中包含需要重新下載或重新建置的快取，清理後首次建置會變慢。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 다운로드하거나 다시 빌드해야 하는 캐시가 포함되어 있어 정리 후 첫 빌드가 느려집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再ダウンロードまたは再ビルドが必要なキャッシュが含まれており、クリーンアップ後の最初のビルドは遅くなります。"
          }
        }
      }
    },
    "clean.confirm.toTrash": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选内容将被移入废纸篓，可在清理前撤销"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected items will be moved to the Trash and can be restored before emptying it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選內容將會移進垃圾桶，可在清空前還原。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목은 휴지통으로 이동하며 비우기 전에 되돌릴 수 있습니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
