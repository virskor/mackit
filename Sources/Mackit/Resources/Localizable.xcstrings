    "welcome.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描开发缓存"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan Development Caches"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描開發快取"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발 캐시 스캔"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発キャッシュをスキャン"
          }
        }
      }
    },
    "welcome.message": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit 会找出 Xcode、Gradle、Go、Node、Flutter 等工具产生的缓存，\n你可以逐项选择后再清理，随时停止。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit finds caches generated by tools like Xcode, Gradle, Go, Node, and Flutter.\nPick items one by one before cleaning, and stop at any time."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit 會找出 Xcode、Gradle、Go、Node、Flutter 等工具產生的快取，\n你可以逐項選擇後再清理，隨時停止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit은 Xcode, Gradle, Go, Node, Flutter 등 도구가 만든 캐시를 찾아냅니다.\n항목을 하나씩 선택한 후 정리할 수 있으며, 언제든지 중지할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MackitはXcode、Gradle、Go、Node、Flutterなどのツールが生成したキャッシュを見つけ出します。\n項目を1つずつ選択してからクリーンアップでき、いつでも停止できます。"
          }
        }
      }
    },
