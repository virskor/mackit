    "share.intro": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit 是一款 macOS 开发缓存清理工具：扫出 Xcode、Node.js、Flutter、CocoaPods 等项目留下的构建产物和缓存，勾选后安全清理，把磁盘空间腾出来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit is a macOS developer cache cleaner. It finds the build artifacts and caches left behind by Xcode, Node.js, Flutter and CocoaPods, and cleans them safely once you have picked what to remove."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit 是一款 macOS 開發快取清理工具：掃出 Xcode、Node.js、Flutter、CocoaPods 等項目留下的建構產物與快取，勾選後安全清理，把磁碟空間騰出來。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit은 macOS 개발 캐시 정리 도구입니다. Xcode, Node.js, Flutter, CocoaPods 등 프로젝트가 남긴 빌드 산출물과 캐시를 찾아내고, 선택한 항목만 안전하게 정리해 디스크 공간을 확보합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MackitはmacOSの開発キャッシュクリーナーです。Xcode、Node.js、Flutter、CocoaPodsなどのプロジェクトが残したビルド成果物とキャッシュを見つけ出し、選択した項目を安全にクリーンアップしてディスクの空き容量を確保します。"
          }
        }
      }
    },
    "share.message": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快来和我一起用 Mackit 清理开发缓存，它帮我腾出了好几十 GB：%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come use Mackit with me to clean developer caches — it freed tens of gigabytes on my Mac: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快來和我一起用 Mackit 清理開發快取，它幫我騰出了好幾十 GB：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit과 함께 개발 캐시를 정리해 보세요. 제 Mac에서 수십 GB를 확보해 주었어요: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackitを一緒に使って開発キャッシュをクリーンアップしましょう。私のMacで数十GBの空き容量を確保してくれました: %@"
          }
        }
      }
    },
