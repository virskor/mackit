    "diskAnalysis.start.explain": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描整个启动磁盘，查看各类文件和文件夹的空间占用，整个过程可能需要几分钟。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the whole startup disk to see which files and folders are taking up the space. A full scan can take a few minutes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描整個啟動磁碟，查看各類檔案和資料夾的空間佔用，整個過程可能需要幾分鐘。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시동 디스크 전체를 스캔하여 어떤 파일과 폴더가 공간을 차지하는지 확인합니다. 전체 스캔에는 몇 분이 걸릴 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動ディスク全体をスキャンして、どのファイルやフォルダが容量を使っているかを確認します。全体のスキャンには数分かかることがあります。"
          }
        }
      }
    },
