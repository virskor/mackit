    "rule.xcode.docs.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 文档缓存"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode Documentation Cache"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 文件快取"
          }
        }
      }
    },
    "rule.xcode.docs.note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的离线文档与搜索索引，删除后 Xcode 会重建"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded documentation and its search index; Xcode rebuilds both"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載的離線文件與搜尋索引，刪除後 Xcode 會重建"
          }
        }
      }
    },
