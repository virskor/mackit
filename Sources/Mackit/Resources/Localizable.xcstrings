    "diskAnalysis.skipped": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未扫描"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not scanned"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未掃描"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔되지 않음"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未スキャン"
          }
        }
      }
    },
    "diskAnalysis.skipped.explain": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描此文件夹需要系统授权。为避免扫描过程中突然弹出的权限对话框，默认跳过；需要时可以手动扫描。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning this folder needs system permission. It is skipped by default so no access dialog pops up mid-scan — you can scan it on demand."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描此檔案夾需要系統授權。為避免掃描過程中突然彈出的權限對話框，預設跳過；需要時可以手動掃描。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더를 스캔하려면 시스템 권한이 필요합니다. 스캔 중에 권한 대화상자가 갑자기 나타나는 것을 피하려고 기본으로 건너뛰며, 필요할 때 수동으로 스캔할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダをスキャンするにはシステムのアクセス権が必要です。スキャン中にアクセス権のダイアログが突然表示されることを避けるため、デフォルトではスキップされます。必要に応じて手動でスキャンできます。"
          }
        }
      }
    },
    "diskAnalysis.skipped.action": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描此文件夹"
