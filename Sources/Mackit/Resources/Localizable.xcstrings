    "settings.update.footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启自动下载后，发现新版本会在后台下载，下载完成后询问是否安装并重启。所有更新包都经过签名校验，未通过校验的更新会被自动拒绝。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When automatic download is on, new versions are fetched in the background and installed only after you confirm. Every update package is signature-checked; anything that fails verification is rejected automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟自動下載後，發現新版本會在背景下載，下載完成後詢問是否安裝並重啟。所有更新套件都經過簽章驗證，未通過驗證的更新會被自動拒絕。"
          }
        }
      }
    },
