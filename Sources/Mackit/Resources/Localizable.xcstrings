    "homebrew.action.cleanup.help": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行 brew cleanup --prune=all -s：删除下载缓存与旧版本的公式，可能需要几分钟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run brew cleanup --prune=all -s — prunes the download cache and old formula versions, can take a few minutes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行 brew cleanup --prune=all -s：刪除下載快取與舊版本的公式，可能需要幾分鐘"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "brew cleanup --prune=all -s 실행: 다운로드 캐시와 오래된 버전의 formula를 삭제합니다. 몇 분 걸릴 수 있습니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brew cleanup --prune=all -s を実行: ダウンロードキャッシュと古いバージョンの formula を削除します。数分かかることがあります"
          }
        }
      }
    },
