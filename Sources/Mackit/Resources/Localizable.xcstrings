{
  "sourceLanguage": "zh-Hans",
  "version": "1.1",
  "strings": {
    "clean.confirm.languageMessage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受影响应用的界面会回退到英文或其他语言，重装或更新应用后才能恢复（共 %lld 个语言包）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The affected apps fall back to English or another language until they are reinstalled or updated (%lld language packs)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受影響 App 的介面會回退到英文或其他語言，重新安裝或更新 App 後才能恢復（共 %lld 個語言套件）。"
          }
        }
      }
    },
    "clean.confirm.languageTitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含无用语言包"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes Unused Language Files"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含無用語言套件"
          }
        }
      }
    },
    "clean.result.movedToTrash": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次移出 %@（移入废纸篓的部分在清空后释放）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved %@ out (what went to the Trash is freed once it is emptied)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次移出 %@（移入垃圾桶的部分在清空後釋放）"
          }
        }
      }
    },
    "menu.checkForUpdates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查更新…"
          }
        }
      }
    },
    "rule.xcode.deriveddata.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DerivedData"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DerivedData"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DerivedData"
          }
        }
      }
    },
    "rule.xcode.deriveddata.note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个项目的构建中间产物，重新打开项目即可生成"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intermediate build artifacts for each project; regenerated when you reopen the project"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個專案的中繼建置產物，重新開啟專案即可產生"
          }
        }
      }
    },
    "rule.xcode.archives.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歸檔"
          }
        }
      }
    },
    "rule.xcode.archives.note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史打包归档，删除后旧版本崩溃将失去符号化能力"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived builds; deleting them loses symbolication for old-version crashes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史打包歸檔，刪除後舊版本崩潰將失去符號化能力"
          }
        }
      }
    },
    "rule.xcode.devicesupport.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS DeviceSupport"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS DeviceSupport"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS DeviceSupport"
          }
        }
      }
    },
    "rule.xcode.devicesupport.note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各版本 iOS 设备的调试符号，连接真机时会重新生成"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug symbols for each iOS version; regenerated when you connect a real device"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各版本 iOS 裝置的偵錯符號，連接實機時會重新產生"
          }
        }
      }
    },
    "rule.xcode.watchdevicesupport.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "watchOS DeviceSupport"
