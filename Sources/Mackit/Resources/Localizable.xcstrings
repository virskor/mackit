    "largeFiles.unreadable.message": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件夹里可能还有更大的文件，授权完全磁盘访问权限后重新扫描即可看到。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There may be even larger files inside them. Grant Full Disk Access and walk again to see them."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些檔案夾裡可能還有更大的檔案，授權完全磁碟存取權限後重新掃描即可看到。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더 안에 더 큰 파일이 있을 수 있습니다. 전체 디스크 접근 권한을 허용하고 다시 스캔하면 볼 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのフォルダの中にさらに大きいファイルがある可能性があります。フルディスクアクセスを許可して再スキャンすると表示されます。"
          }
        }
      }
    },
    "largeFiles.empty.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到足够大的文件"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Files That Large"
