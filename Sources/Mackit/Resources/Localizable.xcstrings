    "permissions.item.fullDiskAccess.what": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取 ~/Library 各处的开发者缓存、应用的最近打开时间，以及大文件扫描中受保护的文件夹"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads developer caches across ~/Library, apps' last-opened times, and the protected folders the large-file walk covers"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取 ~/Library 各處的開發者快取、App 的最近打開時間，以及大檔案掃描中受保護的資料夾"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "~/Library 곳곳에 있는 개발자 캐시, 앱을 마지막으로 연 시간, 큰 파일 스캔이 다루는 보호된 폴더를 읽습니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/Library内の開発ツールのキャッシュ、Appを最後に開いた日時、大きなファイルのスキャンが対象とする保護されたフォルダを読み取ります"
          }
        }
      }
    },
