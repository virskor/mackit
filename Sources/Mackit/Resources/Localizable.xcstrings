    "settings.crashLogs.notice.off": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采集已关闭，新的崩溃不会再被记录；下方是已收集的记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collection is off — new crashes will not be recorded. Below are the records already collected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "採集已關閉，新的崩潰不會再被記錄；下方是已收集的記錄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수집이 꺼져 있어 새로운 크래시는 기록되지 않습니다. 아래는 이미 수집한 기록입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収集はオフです。新しいクラッシュは記録されません。以下は収集済みの記録です。"
          }
        }
      }
    },
