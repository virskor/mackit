    "settings.autoSelectHint.none": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会自动勾选任何条目，所有勾选都由你手动完成。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is auto-selected; every item must be selected manually."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會自動勾選任何項目，所有勾選都由你手動完成。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 항목도 자동으로 선택되지 않으며, 모든 선택은 수동으로 진행합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目は自動では選択されません。すべての選択は手動で行います。"
          }
        }
      }
    },
    "settings.autoSelectHint.safe": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只自动勾选纯缓存；需留意与谨慎项需要你手动勾选。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only pure caches are auto-selected; review and caution items need manual selection."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會自動勾選純快取；需留意與謹慎項目需要你手動勾選。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순수 캐시만 자동으로 선택되고, 검토 및 주의 항목은 수동으로 선택해야 합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "純粋なキャッシュのみが自動的に選択されます。確認が必要な項目と注意が必要な項目は手動で選択する必要があります。"
          }
        }
      }
    },
    "settings.autoSelectHint.review": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动勾选缓存与需重新下载的产物；谨慎项（废纸篓、iOS 备份）仍需手动勾选。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches and items that need re-downloading are auto-selected; caution items (Trash, iOS backups) still need manual selection."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會自動勾選快取與需要重新下載的產物；謹慎項目（垃圾桶、iOS 備份）仍需手動勾選。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시와 다시 다운로드해야 하는 항목은 자동으로 선택되고, 주의 항목(휴지통, iOS 백업)은 수동으로 선택해야 합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュと再ダウンロードが必要な項目は自動的に選択されます。注意が必要な項目（ゴミ箱、iOSバックアップ）は手動で選択する必要があります。"
          }
        }
      }
    },
    "settings.autoSelectHint.caution": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有发现的条目都会被勾选，清理前请仔细核对确认面板。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All discovered items are selected; review the confirmation sheet carefully before cleaning."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有發現的項目都會被勾選，清理前請仔細核對確認面板。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발견된 모든 항목이 선택됩니다. 정리하기 전에 확인 시트를 주의 깊이 검토하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つかったすべての項目が選択されます。クリーンアップする前に確認シートをよく確認してください。"
          }
        }
      }
    },
