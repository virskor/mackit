      }
    },
    "largeFiles.start.protected.help": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这三个文件夹受系统保护，扫描时可能弹出一个授权提示；授权后本次使用不再询问。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These folders are protected by macOS, so scanning them may pop up a permission prompt; once granted, it is remembered for this session."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這三個檔案夾受系統保護，掃描時可能弹出一個授權提示；授權後本次使用不再詢問。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세 폴더는 macOS가 보호하므로 스캔할 때 권한 요청이 표시될 수 있습니다. 허용하면 이번 사용 중에는 다시 묻지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この3つのフォルダはmacOSによって保護されているため、スキャンするとアクセス権のプロンプトが表示される場合があります。一度許可すれば、今回の使用中は再度求められません。"
          }
        }
      }
    },
