    "permissions.item.automationFinder.what": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让“在 Finder 中显示”选中文件本身，而不只是打开所在文件夹"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets \"Show in Finder\" select the file itself instead of only opening its folder"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓「在 Finder 中顯示」選取檔案本身，而不只是打開所在資料夾"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Finder에서 보기\"가 폴더만 여는 것이 아니라 파일 자체를 선택하도록 합니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Finderで表示」がフォルダを開くだけでなく、ファイル自体を選択できるようにします"
          }
        }
      }
    },
    "permissions.item.automationTerminal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动化：控制终端"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation: control Terminal"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動化：控制終端機"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화: Terminal 제어"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動操作: ターミナルの操作"
          }
        }
      }
    },
    "permissions.item.automationTerminal.what": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在终端中打开缓存所在的目录"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a cache's directory in Terminal"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在終端機中打開快取所在的目錄"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시가 있는 디렉토리를 Terminal에서 엽니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュのあるディレクトリをターミナルで開きます"
          }
        }
      }
    },
    "permissions.item.administrator": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理员权限"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrator"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統管理者權限"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 권한"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者権限"
          }
        }
      }
    },
    "permissions.item.administrator.what": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "释放内存时以管理员身份运行 purge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs purge as administrator when freeing memory"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釋放記憶體時以系統管理者身分執行 purge"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리를 확보할 때 관리자 권한으로 purge를 실행합니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリを解放するときに管理者としてpurgeを実行します"
          }
        }
      }
    },
    "permissions.status.granted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授予"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granted"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已授予"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용됨"
          }
        },
        "ja": {
          "stringUnit": {
