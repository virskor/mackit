    "rule.xcode.docs.note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的离线文档与搜索索引，删除后 Xcode 会重建"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded documentation and its search index; Xcode rebuilds both"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載的離線文件與搜尋索引，刪除後 Xcode 會重建"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 오프라인 문서와 검색 인덱스, 삭제 후 Xcode가 다시 빌드"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたオフラインのドキュメントと検索インデックス、削除後は Xcode が再構築します"
          }
        }
      }
    },
