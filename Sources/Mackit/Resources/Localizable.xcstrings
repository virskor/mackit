        }
      }
    },
    "rule.xcode.devicesupport.note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各版本 iOS 设备的调试符号，连接真机时会重新生成"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug symbols for each iOS version; regenerated when you connect a real device"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各版本 iOS 裝置的偵錯符號，連接實機時會重新產生"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 iOS 버전의 디버그 기호, 실제 기기 연결 시 다시 생성"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各 iOS バージョンのデバッグシンボル、実機を接続すると再生成されます"
          }
        }
      }
    },
