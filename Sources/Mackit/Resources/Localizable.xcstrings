    "share.intro": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit 是一款 macOS 开发缓存清理工具：扫出 Xcode、Node.js、Flutter、CocoaPods 等项目留下的构建产物和缓存，勾选后安全清理，把磁盘空间腾出来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit is a macOS developer cache cleaner. It finds the build artifacts and caches left behind by Xcode, Node.js, Flutter and CocoaPods, and cleans them safely once you have picked what to remove."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackit 是一款 macOS 開發快取清理工具：掃出 Xcode、Node.js、Flutter、CocoaPods 等項目留下的建構產物與快取，勾選後安全清理，把磁碟空間騰出來。"
          }
        }
      }
    },
    "share.message": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快来和我一起用 Mackit 清理开发缓存，它帮我腾出了好几十 GB：%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come use Mackit with me to clean developer caches — it freed tens of gigabytes on my Mac: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快來和我一起用 Mackit 清理開發快取，它幫我騰出了好幾十 GB：%@"
          }
        }
      }
    },
