          }
        }
      }
    },
    "rule.sim.coresimulator-caches.note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器动态库缓存，体积大且可完全重建"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator dynamic library caches; large but fully rebuildable"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬器動態函式庫快取，體積大且可完全重建"
          }
        }
      }
    },
    "rule.sim.device-caches.title": {
      "localizations": {
        "zh-Hans": {
