          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This record carries no image information, so its frames cannot be resolved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這筆記錄沒有映像資訊，無法解析回溯位址。"
          }
        }
      }
    },
    "crashLogs.symbolize.noOwnFrames": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回溯中没有属于 Mackit 自身的堆栈帧。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of the frames belong to Mackit's own code."
