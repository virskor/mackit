          }
        }
      }
    },
    "largeFiles.start.explain": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遍历整个启动磁盘，找出占用空间最大的文件。整个过程可能需要几分钟。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk the whole startup disk and list the files taking up the most space. A full walk can take a few minutes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遍历整個啟動磁碟，找出佔用空間最大的檔案。整個過程可能需要幾分鐘。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시동 디스크 전체를 탐색하여 가장 많은 공간을 차지하는 파일을 찾습니다. 전체 탐색에는 몇 분이 걸릴 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動ディスク全体をスキャンして、最も多くの容量を占めるファイルを一覧表示します。全体のスキャンには数分かかることがあります。"
          }
        }
      }
    },
    "largeFiles.start.protected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含“文档 / 桌面 / 下载”文件夹"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include Documents, Desktop and Downloads"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含「文件 / 桌面 / 下載」檔案夾"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'문서 / 데스크탑 / 다운로드' 폴더 포함"
          }
        },
        "ja": {
          "stringUnit": {
