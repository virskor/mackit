    "diskAnalysis.fdaHint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果系统提示需要权限，请在“系统设置 › 隐私与安全性 › 完全磁盘访问权限”中允许 Mackit。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If macOS asks for permission, allow Mackit in System Settings › Privacy & Security › Full Disk Access."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果系統提示需要權限，請在「系統設定 › 隱私與安全性 › 完全磁碟存取權限」中允許 Mackit。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템에서 권한을 요청하면 \"시스템 설정 › 개인 정보 보호 및 보안 › 전체 디스크 접근 권한\"에서 Mackit을 허용하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムがアクセス権を求めてきた場合は、「システム設定 › プライバシーとセキュリティ › フルディスクアクセス」でMackitを許可してください。"
          }
        }
      }
    },
