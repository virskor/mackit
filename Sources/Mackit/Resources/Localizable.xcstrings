    "settings.includeAppsHint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在通用清理的「应用垃圾」一行中列出各应用可再生的缓存、日志等残留文件；卸载应用请使用工具区的「应用卸载」"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists the regenerable junk installed apps leave behind (caches, logs, …) in the general cleanup's App Junk row; to uninstall apps, use the App Uninstall tool"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在通用清理的「應用垃圾」一行中列出各應用可再生的快取、日誌等殘留檔案；卸載應用請使用工具區的「應用卸載」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 정리의 \"앱 정크\" 행에 설치된 앱이 남긴 재생 가능한 캐시, 로그 등의 잔여 파일을 표시합니다. 앱을 제거하려면 도구 섹션의 \"앱 제거\"를 사용하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一般クリーンアップの「Appのジャンク」の行に、インストールされたAppが残す再生可能なキャッシュやログなどの残りファイルを一覧表示します。Appをアンインストールするには、ツールセクションの「Appのアンインストール」を使用してください。"
          }
        }
      }
    },
