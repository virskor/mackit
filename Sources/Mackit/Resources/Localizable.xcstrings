    "rule.xcode.deriveddata.note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个项目的构建中间产物，重新打开项目即可生成"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intermediate build artifacts for each project; regenerated when you reopen the project"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個專案的中繼建置產物，重新開啟專案即可產生"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 프로젝트의 중간 빌드 산출물, 프로젝트를 다시 열면 생성됨"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各プロジェクトの中間のビルド成果物、プロジェクトを開き直すと生成されます"
          }
        }
      }
    },
    "rule.xcode.archives.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歸檔"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives"
          }
        }
      }
    },
    "rule.xcode.archives.note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史打包归档，删除后旧版本崩溃将失去符号化能力"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived builds; deleting them loses symbolication for old-version crashes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史打包歸檔，刪除後舊版本崩潰將失去符號化能力"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "과거 빌드의 아카이브, 삭제하면 이전 버전 충돌의 심볼케이션이 불가능합니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去のビルドのアーカイブ、削除すると旧バージョンのクラッシュのシンボリケーションができなくなります"
          }
        }
      }
    },
    "rule.xcode.devicesupport.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS DeviceSupport"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS DeviceSupport"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
