          "stringUnit": {
            "state": "translated",
            "value": "DerivedData"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DerivedData"
          }
        }
      }
    },
    "rule.xcode.deriveddata.note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个项目的构建中间产物，重新打开项目即可生成"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intermediate build artifacts for each project; regenerated when you reopen the project"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個專案的中繼建置產物，重新開啟專案即可產生"
          }
        }
      }
    },
    "rule.xcode.archives.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歸檔"
