    "settings.menubar.footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 与内存取自系统公开接口。macOS 没有公开的温度数值接口，温度行显示的是系统热状态。「释放内存」会请求管理员授权并执行 purge，清空磁盘文件缓存；应用自身占用的内存不会被释放。关闭图标后，若三项数值也全部关闭，菜单栏仍会保留图标，否则应用将从菜单栏消失。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU and memory come from public system APIs. macOS exposes no numeric temperature reading, so the temperature row shows the system thermal state. “Free Up Memory” asks for administrator authorization and runs purge, which flushes the disk file cache; memory held by apps is not released. With the icon off and every value off as well, the icon is kept anyway — otherwise the app would disappear from the menu bar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 與記憶體取自系統公開介面。macOS 沒有公開的溫度數值介面，溫度列顯示的是系統熱狀態。「釋放記憶體」會請求管理員授權並執行 purge，清空磁碟檔案快取；應用程式本身佔用的記憶體不會被釋放。關閉圖示後，若三項數值也全部關閉，選單列仍會保留圖示，否則應用程式將從選單列消失。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU와 메모리는 시스템의 공개 인터페이스에서 가져옵니다. macOS는 숫자로 된 온도 값을 공개하지 않으므로 온도 행에는 시스템 열 상태가 표시됩니다. \"메모리 확보\"는 관리자 권한을 요청하고 purge를 실행하여 디스크 파일 캐시를 비웁니다. 앱이 사용하는 메모리는 해제되지 않습니다. 아이콘을 끈 후 세 가지 값도 모두 끄면 아이콘이 그대로 유지됩니다. 그렇지 않으면 앱이 메뉴 막대에서 사라지게 됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPUとメモリはシステムの公開インターフェイスから取得されます。macOSは数値での温度読み取り値を公開していないため、温度行にはシステムのサーマル状態が表示されます。「メモリを解放」は管理者の認証を求めてpurgeを実行し、ディスクのファイルキャッシュをフラッシュします。App自身が使用するメモリは解放されません。アイコンをオフにした後、3つの値もすべてオフにすると、アイコンはそれでも維持されます。そうしないと、Appがメニューバーから消えてしまいます。"
          }
        }
      }
    },
    "settings.overlay.header": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面悬浮窗"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Overlay"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面懸浮窗"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크탑 플로팅 창"
          }
        },
