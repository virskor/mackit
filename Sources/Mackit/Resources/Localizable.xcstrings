    "category.browser.summary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装浏览器的网页缓存与脚本缓存，退出浏览器后清理更彻底"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web and script caches of installed browsers; quit them first for a complete sweep"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝瀏覽器的網頁快取與指令碼快取，退出瀏覽器後清理更徹底"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 브라우저의 웹 캐시와 스크립트 캐시. 브라우저를 먼저 종료하면 더 철저하게 정리됩니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みブラウザのWebキャッシュとスクリプトキャッシュ。ブラウザを終了してからクリーンアップするとより徹底的に削除できます"
          }
        }
      }
    },
    "category.language.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无用语言包"
