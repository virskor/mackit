        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Crash Logs Yet"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無崩潰記錄"
          }
        }
      }
    },
