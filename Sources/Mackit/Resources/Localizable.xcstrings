    "crashLogs.symbolize.noImageRange": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条记录没有镜像信息，无法解析回溯地址。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This record carries no image information, so its frames cannot be resolved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這筆記錄沒有映像資訊，無法解析回溯位址。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기록에는 이미지 정보가 없어 콜 스택 주소를 분석할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この記録にはイメージ情報がないため、コールスタックのアドレスを解析できません。"
          }
        }
      }
    },
    "crashLogs.symbolize.noOwnFrames": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回溯中没有属于 Mackit 自身的堆栈帧。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of the frames belong to Mackit's own code."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回溯中沒有屬於 Mackit 自身的堆疊框。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콜 스택에 Mackit 자체의 스택 프레임이 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コールスタックに Mackit 自身のスタックフレームがありません。"
          }
        }
      }
    },
    "crashLogs.symbolize.binaryMissing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录中指定的应用二进制文件已不在磁盘上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app binary this record names is no longer on disk."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄中指定的應用程式二進位檔已不在磁碟上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록에 지정된 앱 바이너리 파일이 더 이상 디스크에 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録に指定されたAppのバイナリファイルがディスク上にありません。"
          }
        }
      }
    },
    "crashLogs.symbolize.binaryReplaced": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "崩溃发生在 %1$@，但现在安装的是 %2$@；用新二进制解析旧记录会得出错误的符号。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ crashed, but %2$@ is installed now — resolving against the new binary would produce wrong symbols."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "崩潰發生在 %1$@，但現在安裝的是 %2$@；用新二進位檔解析舊記錄會得出錯誤的符號。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 크래시가 발생했지만 현재 설치된 버전은 %2$@입니다. 새 바이너리로 오래된 기록을 분석하면 잘못된 심볼이 생성됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@でクラッシュが発生しましたが、現在インストールされているのは%2$@です。新しいバイナリで古い記録を解析すると、誤ったシンボルが生成されます。"
          }
        }
      }
    },
    "crashLogs.symbolize.atosFailed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统符号化工具运行失败。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system symbolizer failed to run."
