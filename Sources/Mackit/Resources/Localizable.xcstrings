    "settings.update.footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启自动下载后，发现新版本会在后台下载，下载完成后询问是否安装并重启。所有更新包都经过签名校验，未通过校验的更新会被自动拒绝。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When automatic download is on, new versions are fetched in the background and installed only after you confirm. Every update package is signature-checked; anything that fails verification is rejected automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟自動下載後，發現新版本會在背景下載，下載完成後詢問是否安裝並重啟。所有更新套件都經過簽章驗證，未通過驗證的更新會被自動拒絕。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 다운로드를 켜두면 새 버전이 백그라운드에서 다운로드되고, 다운로드가 완료되면 설치 및 재시작 여부를 묻습니다. 모든 업데이트 패키지는 서명을 확인하며, 확인에 실패한 업데이트는 자동으로 거부됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動ダウンロードをオンにすると、新しいバージョンがバックグラウンドでダウンロードされ、ダウンロード完了後にインストールと再起動の確認を求めます。すべてのアップデートパッケージは署名を検証し、検証に失敗したアップデートは自動的に拒否されます。"
          }
        }
      }
    },
