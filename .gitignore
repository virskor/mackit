# Local config and keys (if committed by mistake)
*.p8
*.p12
*.pem
*.key
*.mobileprovision
*.cer
*.certSigningRequest
.env
.env.*
!.env.example
secrets.*
# Local private-key directory: files live in the repo for convenience but never
# enter git and never reach the remote.
secrets/
# Public certificates are public information; allow that one file under
# Certificates/ to be archived in the repo;
# private keys (*.pem / *.p8 / *.key) are still blocked by the rules above.
!Certificates/developerID_application.cer

